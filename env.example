# Translation Service Configuration
# Choose one of the following providers and add your API key

# Google Translate (Paid, high quality)
# NEXT_PUBLIC_GOOGLE_TRANSLATE_API_KEY=your_google_api_key_here

# Microsoft Translator (Paid, high quality) 
# NEXT_PUBLIC_MICROSOFT_TRANSLATOR_API_KEY=your_microsoft_api_key_here
# NEXT_PUBLIC_MICROSOFT_TRANSLATOR_REGION=global

# LibreTranslate (Free, open source)
# NEXT_PUBLIC_LIBRETRANSLATE_URL=https://libretranslate.de
# NEXT_PUBLIC_LIBRETRANSLATE_API_KEY=optional_api_key_for_rate_limits

# Development settings
NODE_ENV=development

# ISR (Incremental Static Regeneration) Configuration
# Secret token for on-demand revalidation API
REVALIDATION_SECRET=your-secret-token-change-in-production

# Enable ISR in development (optional, defaults to production only)
# ENABLE_ISR=true

# API Configuration
NEXT_PUBLIC_API_URL=your_api_base_url_here

# Google Calendar API Configuration (for meeting scheduling)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Email Configuration (for meeting notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here

# Company Configuration
COMPANY_AGENT_EMAIL=agent@rinoestates.com
